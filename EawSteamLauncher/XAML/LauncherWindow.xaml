<Window x:Name="MainLauncherWindow" x:Class="EawSteamLauncher.LauncherWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:EawSteamLauncher"
        mc:Ignorable="d"
        Title="EAW Steam Launcher" Height="400" Width="500" ResizeMode="NoResize" Loaded="MainLauncherWindow_Loaded">

    <Grid>
        <TabControl>
            <TabItem Header="Launcher" Width="100">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.5*"/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>

                    <GroupBox Grid.Column="0" Header="Mod selection" Margin="4, 2, 4, 4">
                        <Grid Grid.Column="0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition />
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <CheckBox x:Name="ChkPlayUnmodified" Content="Play without mod" Margin="4, 2, 4, 2"/>

                            <ListBox x:Name="ListMod" Grid.Row="1" Margin="4, 2, 4, 2">
                                <ListBoxItem>Test</ListBoxItem>
                                <ListBoxItem>Item</ListBoxItem>
                                <ListBoxItem>Test</ListBoxItem>
                                <ListBoxItem>Item</ListBoxItem>
                                <ListBoxItem>Test</ListBoxItem>
                                <ListBoxItem>Item</ListBoxItem>
                            </ListBox>
                        </Grid>
                    </GroupBox>

                    <Grid Grid.Column="1">
                        <Grid.RowDefinitions>
                            <RowDefinition/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <GroupBox Header="Launch options" Grid.Row="0" Margin="4, 2, 4, 2">
                            <StackPanel>

                                <Label Content="Language selection" Margin="4, 2, 4, 2" Padding="Auto"/>
                                <ComboBox x:Name="ComboLanguage" Margin="4, 2, 4, 2" SelectedIndex="0">

                                </ComboBox>
                            </StackPanel>

                        </GroupBox>

                        <Button x:Name="BtnLaunch" Content ="Launch" Grid.Row="1" Margin="4, 2, 4, 4" Padding="10" Click="BtnLaunch_Click"/>
                    </Grid>
                </Grid>
            </TabItem>
            <TabItem Header="Settings" Width="100">

            </TabItem>
        </TabControl>
    </Grid>
</Window>